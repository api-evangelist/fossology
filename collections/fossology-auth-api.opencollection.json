{
  "opencollection": "1.0.0",
  "info": {
    "name": "FOSSology Admin auth API",
    "version": "1.6.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a new token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost/repo/api/v1/tokens",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Generate a new token to access REST API\n"
        }
      ]
    }
  ],
  "bundled": true
}